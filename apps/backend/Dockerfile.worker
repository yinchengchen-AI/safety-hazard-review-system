# BullMQ worker (report generation, notification cleanup, statistics jobs).
# Same base image as the API; runs a NestApplicationContext instead of
# an HTTP server.
FROM docker.m.daocloud.io/node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json ./
COPY src ./src
COPY prisma ./prisma
RUN npx prisma generate && npm run build

FROM docker.m.daocloud.io/node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
CMD ["node", "dist/src/queues/worker.js"]
